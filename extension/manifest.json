{
  "manifest_version": 3,
  "name": "Shadow AI DLP",
  "version": "2.0.0",
  "description": "DLP local para chats de IA. Redacta PII en el navegador antes de que salga hacia ChatGPT, Claude, Gemini, Grok y otras IAs web.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://bard.google.com/*",
    "https://aistudio.google.com/*",
    "https://notebooklm.google.com/*",
    "https://grok.com/*",
    "https://grok.x.ai/*",
    "https://x.com/i/grok*",
    "https://copilot.microsoft.com/*",
    "https://copilot.cloud.microsoft/*",
    "https://www.bing.com/chat*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://chat.deepseek.com/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "https://chat.mistral.ai/*",
    "https://huggingface.co/chat*",
    "https://poe.com/*",
    "https://you.com/*",
    "https://chat.qwen.ai/*",
    "https://kimi.com/*",
    "https://www.kimi.com/*",
    "https://character.ai/*",
    "https://pi.ai/*",
    "https://openrouter.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shadow AI DLP"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://bard.google.com/*",
        "https://aistudio.google.com/*",
        "https://notebooklm.google.com/*",
        "https://grok.com/*",
        "https://grok.x.ai/*",
        "https://x.com/i/grok*",
        "https://copilot.microsoft.com/*",
        "https://copilot.cloud.microsoft/*",
        "https://www.bing.com/chat*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*",
        "https://chat.mistral.ai/*",
        "https://huggingface.co/chat*",
        "https://poe.com/*",
        "https://you.com/*",
        "https://chat.qwen.ai/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://character.ai/*",
        "https://pi.ai/*",
        "https://openrouter.ai/*"
      ],
      "js": ["platforms.js", "redact-core.js", "injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://bard.google.com/*",
        "https://aistudio.google.com/*",
        "https://notebooklm.google.com/*",
        "https://grok.com/*",
        "https://grok.x.ai/*",
        "https://x.com/i/grok*",
        "https://copilot.microsoft.com/*",
        "https://copilot.cloud.microsoft/*",
        "https://www.bing.com/chat*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*",
        "https://chat.mistral.ai/*",
        "https://huggingface.co/chat*",
        "https://poe.com/*",
        "https://you.com/*",
        "https://chat.qwen.ai/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://character.ai/*",
        "https://pi.ai/*",
        "https://openrouter.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
